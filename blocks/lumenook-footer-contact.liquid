{% doc %}
  Footer contact column (brief Section 6): heading, WhatsApp (from Theme settings > Lumenook),
  email and opening hours. The WhatsApp line appears automatically once a number is set.
{% enddoc %}
{%- assign number = settings.ln_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
<div class="ln-footer-contact" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="ln-footer-contact__heading h6">{{ block.settings.heading }}</h2>
  {%- endif -%}
  <ul class="ln-footer-contact__list" role="list">
    {%- if number != blank -%}
      <li>
        <a href="https://wa.me/{{ number }}" target="_blank" rel="noopener">
          {{- 'lumenook.whatsapp.footer_label' | t -}}
        </a>
      </li>
    {%- endif -%}
    {%- if block.settings.email != blank -%}
      <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
    {%- endif -%}
    {%- if block.settings.hours != blank -%}
      <li>{{ block.settings.hours }}</li>
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "Lumenook footer contact",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "CONTACT" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@lumenook.com" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Sun–Thu, 10:00–19:00 GST" }
  ],
  "presets": [{ "name": "Lumenook footer contact" }]
}
{% endschema %}
