{%- comment -%}
  Lumenook: only the body and accent fonts (Jost) are preloaded. Headings use the self-hosted
  Cormorant Garamond (preloaded in snippets/lumenook-head.liquid), so preloading the Shopify-hosted
  Cormorant heading/subheading files would download fonts the page never uses.
{%- endcomment -%}
{%- unless settings.type_body_font.system? -%}
  {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
{%- unless settings.type_accent_font.system? -%}
  {{ settings.type_accent_font | font_url | preload_tag: as: 'font', type: 'font/woff2', fetchpriority: 'low' }}
{%- endunless -%}
