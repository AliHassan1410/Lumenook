{% doc %}
  Floating WhatsApp button (brief Section 10), bottom end-side, product pages only.
  Hidden until a number is set in Theme settings > Lumenook.
{% enddoc %}
{%- liquid
  assign number = settings.ln_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
-%}
{%- if number != blank and template.name == 'product' -%}
  {%- capture message -%}{{ 'lumenook.whatsapp.product_message' | t: title: product.title }}{%- endcapture -%}
  <a
    class="ln-whatsapp"
    href="https://wa.me/{{ number }}?text={{ message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'lumenook.whatsapp.label' | t }}"
  >
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M20 12a8 8 0 01-11.8 7L4 20l1.1-4A8 8 0 1120 12z"/>
      <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.2-1.8-.9-.8.8a4 4 0 01-2.6-2.6l.8-.8-.9-1.8L9 9.5z"/>
    </svg>
  </a>
{%- endif -%}
