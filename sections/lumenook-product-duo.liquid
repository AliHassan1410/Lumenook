{% comment %}
  Product image row: up to three of the product's images in an even row inside the page width,
  under a small eyebrow heading. Skips the first image (already the gallery hero) when the
  product has four or more images. Renders nothing with fewer than two images.
{% endcomment %}
{%- liquid
  assign images = product.images
  assign offset = 0
  if images.size >= 4
    assign offset = 1
  endif
  assign count = images.size | minus: offset | at_most: 3
  assign sizes = '(min-width: 750px) 30vw, 33vw'
-%}
{%- if count >= 2 -%}
  <section class="ln-duo ln-duo--{{ count }}" aria-labelledby="LnDuo-{{ section.id }}">
    <p class="ln-eyebrow ln-duo__heading" id="LnDuo-{{ section.id }}">{{ 'lumenook.product.in_detail' | t }}</p>
    <div class="ln-duo__grid">
      {%- for image in images offset: offset limit: count -%}
        {%- assign image_alt = image.alt | default: product.title -%}
        <figure class="ln-duo__item">
          {{
            image
            | image_url: width: 1200
            | image_tag: widths: '300, 450, 600, 900, 1200', sizes: sizes, loading: 'lazy', class: 'ln-duo__image', alt: image_alt
          }}
        </figure>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lumenook image row",
  "settings": [],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Lumenook image row" }]
}
{% endschema %}
