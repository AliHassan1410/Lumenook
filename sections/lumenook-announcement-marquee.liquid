{% comment %}
  Announcement bar as a continuous marquee: messages scroll right to left (left to right in RTL).
  Pauses on hover/focus; static and centred when the shopper prefers reduced motion.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
-%}
{%- if count > 0 -%}
  {%- capture items -%}
    {%- for block in section.blocks -%}
      <li class="ln-marquee__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </li>
    {%- endfor -%}
  {%- endcapture -%}
  <div
    class="ln-marquee"
    role="region"
    aria-label="{{ 'lumenook.general.announcements' | t }}"
    style="--ln-marquee-bg: {{ s.background_color }}; --ln-marquee-text: {{ s.text_color }}; --ln-marquee-duration: {{ s.speed | times: count }}s;"
  >
    <div class="ln-marquee__track">
      <ul class="ln-marquee__list" role="list">{{ items }}</ul>
      <ul class="ln-marquee__list" role="list" aria-hidden="true">{{ items }}</ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Lumenook marquee bar",
  "class": "ln-marquee-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 4, "max": 20, "step": 1, "default": 8 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#B08D57" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1917" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Complimentary delivery across the UAE over AED 300" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumenook marquee bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Complimentary delivery across the UAE over AED 300" } },
        { "type": "message", "settings": { "text": "Cash on delivery available" } },
        { "type": "message", "settings": { "text": "Gift wrapping on request" } }
      ]
    }
  ]
}
{% endschema %}
