{% comment %}
  Collections index (owner request): plain Ivory header, four collections per row on desktop,
  two on mobile, real pagination (the store list can outgrow one page). Cards reuse the same
  frame/title styles as the "Pairs well with" cards elsewhere on the site.
{% endcomment %}
{%- liquid
  assign per_page = section.settings.collections_per_page | default: 12
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'lumenook.general.all_collections' | t
  endif
-%}
<section class="ln-banner">
  <div class="ln-container ln-banner__content">
    <h1 class="ln-banner__title">{{ heading }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="ln-banner__intro">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>

<div class="ln-section ln-section--top-tight">
  <div class="ln-container">
    {%- paginate collections by per_page -%}
      <ul class="ln-grid ln-grid--4" role="list">
        {%- for collection in collections -%}
          <li>
            <a class="ln-card__link" href="{{ collection.url }}">
              <div class="ln-card__media">
                {%- if collection.featured_image != blank -%}
                  {{
                    collection.featured_image
                    | image_url: width: 800
                    | image_tag: widths: '300, 450, 600, 800', sizes: '(min-width: 990px) 23vw, 45vw', loading: 'lazy', alt: '', class: 'ln-card__image'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'ln-card__image' }}
                {%- endif -%}
              </div>
              <h2 class="ln-card__title">{{ collection.title }}</h2>
              {%- if collection.products_count > 0 -%}
                <p class="ln-card__subtitle">{{ 'lumenook.collection.pieces' | t: count: collection.products_count }}</p>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination-controls', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:names.collection_list",
  "class": "ui-test-collection-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "All collections"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "t:settings.collection_count",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
