{% comment %}
  Circle feature: a product image in a round frame at the centre, three short lines of
  generic brand copy on each side. Lines respond gently on hover/focus.
  Image: the section's image setting, otherwise the product's featured image.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign image = s.image
  if image == blank and product != blank
    assign image = product.featured_image
  endif
  assign image_alt = image.alt | default: product.title
-%}
<section class="ln-circle ln-section" aria-labelledby="LnCircle-{{ section.id }}">
  <div class="ln-container">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <header class="ln-circle__header">
        {%- if s.eyebrow != blank -%}<p class="ln-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ln-section__heading ln-circle__heading" id="LnCircle-{{ section.id }}">{{ s.heading }}</h2>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="ln-circle__layout">
      <ul class="ln-circle__list ln-circle__list--start" role="list">
        {%- for i in (1..3) -%}
          {%- assign t_key = 'left_title_' | append: i -%}
          {%- assign d_key = 'left_text_' | append: i -%}
          {%- if s[t_key] != blank -%}
            <li class="ln-circle__item" tabindex="0">
              <span class="ln-circle__title">{{ s[t_key] }}</span>
              {%- if s[d_key] != blank -%}<span class="ln-circle__text">{{ s[d_key] }}</span>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="ln-circle__media">
        <div class="ln-circle__frame">
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 900
              | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 360px, 70vw', loading: 'lazy', class: 'ln-circle__image', alt: image_alt
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ln-circle__image' }}
          {%- endif -%}
        </div>
      </div>

      <ul class="ln-circle__list ln-circle__list--end" role="list">
        {%- for i in (1..3) -%}
          {%- assign t_key = 'right_title_' | append: i -%}
          {%- assign d_key = 'right_text_' | append: i -%}
          {%- if s[t_key] != blank -%}
            <li class="ln-circle__item" tabindex="0">
              <span class="ln-circle__title">{{ s[t_key] }}</span>
              {%- if s[d_key] != blank -%}<span class="ln-circle__text">{{ s[d_key] }}</span>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lumenook circle feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Lumenook way" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chosen with care" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the product's main image." },
    { "type": "header", "content": "Left side" },
    { "type": "text", "id": "left_title_1", "label": "Line 1 title", "default": "Considered design" },
    { "type": "text", "id": "left_text_1", "label": "Line 1 text", "default": "Chosen for its form as much as its function." },
    { "type": "text", "id": "left_title_2", "label": "Line 2 title", "default": "Warm, calm light" },
    { "type": "text", "id": "left_text_2", "label": "Line 2 text", "default": "Made for slow evenings and quiet corners." },
    { "type": "text", "id": "left_title_3", "label": "Line 3 title", "default": "Made to live with" },
    { "type": "text", "id": "left_text_3", "label": "Line 3 text", "default": "Pieces that sit comfortably in any room." },
    { "type": "header", "content": "Right side" },
    { "type": "text", "id": "right_title_1", "label": "Line 1 title", "default": "Delivered with care" },
    { "type": "text", "id": "right_text_1", "label": "Line 1 text", "default": "Packed carefully and sent across the UAE." },
    { "type": "text", "id": "right_title_2", "label": "Line 2 title", "default": "Ready to gift" },
    { "type": "text", "id": "right_text_2", "label": "Line 2 text", "default": "Add a gift note and we will include it." },
    { "type": "text", "id": "right_title_3", "label": "Line 3 title", "default": "Here to help" },
    { "type": "text", "id": "right_text_3", "label": "Line 3 text", "default": "Questions before or after you buy? Just ask." }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Lumenook circle feature" }]
}
{% endschema %}
