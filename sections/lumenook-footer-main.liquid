{% comment %}
  Lumenook Footer — custom section matching the brand design:
  • Newsletter bar (heading + email input + subscribe) on full-width dark row
  • 4-column main footer: Logo+tagline | SHOP links | HELP links | LUMENOOK links
  • Bottom bar: copyright left, Terms & Policies right
{% endcomment %}

{%- liquid
  assign shop_menu  = linklists['footer-shop']
  assign help_menu  = linklists['footer-help']
  assign brand_menu = linklists['footer-lumenook']
-%}

<footer class="ln-footer" role="contentinfo">

  {%- comment -%} ── Newsletter bar ── {%- endcomment -%}
  <div class="ln-footer__newsletter">
    <div class="ln-footer__inner ln-footer__newsletter-grid">
      <div class="ln-footer__nl-copy">
        <h2 class="ln-footer__nl-heading">Join the Lumenook circle</h2>
        <p class="ln-footer__nl-sub">Early access to new pieces and quiet evenings, in your inbox.</p>
      </div>
      <form class="ln-footer__nl-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="ln-footer__nl-row">
          <input
            class="ln-footer__nl-input"
            type="email"
            name="contact[email]"
            id="ln-newsletter-email"
            placeholder="Email address"
            autocomplete="email"
            required
            aria-label="Email address"
          >
          <button class="ln-footer__nl-btn" type="submit">SUBSCRIBE</button>
        </div>
        <div class="ln-footer__nl-line" aria-hidden="true"></div>
      </form>
    </div>
  </div>

  {%- comment -%} ── Divider ── {%- endcomment -%}
  <div class="ln-footer__divider" aria-hidden="true"></div>

  {%- comment -%} ── Main 4-column body ── {%- endcomment -%}
  <div class="ln-footer__body">
    <div class="ln-footer__inner ln-footer__cols">

      {%- comment -%} Col 1 — Logo + tagline + contact {%- endcomment -%}
      <div class="ln-footer__col ln-footer__col--brand">
        <a href="/" class="ln-footer__logo-link" aria-label="{{ shop.name }}">
          {%- render 'lumenook-logo', class: 'ln-logo--footer' -%}
        </a>
        <p class="ln-footer__tagline">Light for your quiet corner. Curated lamps and desk objects, delivered across the UAE.</p>
        <a class="ln-footer__email" href="mailto:info@lumenook.com">info@lumenook.com</a>
      </div>

      {%- comment -%} Col 2 — SHOP {%- endcomment -%}
      <div class="ln-footer__col">
        <h3 class="ln-footer__col-heading">SHOP</h3>
        {%- if shop_menu != blank -%}
          <ul class="ln-footer__links" role="list">
            {%- for link in shop_menu.links -%}
              {%- unless link.title contains 'Track' -%}
                <li><a class="ln-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <ul class="ln-footer__links" role="list">
            <li><a class="ln-footer__link" href="/collections/lighting">Lighting</a></li>
            <li><a class="ln-footer__link" href="/collections/desk-objects">Desk Objects</a></li>
            <li><a class="ln-footer__link" href="/collections/new-arrivals">New Arrivals</a></li>
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Col 3 — HELP {%- endcomment -%}
      <div class="ln-footer__col">
        <h3 class="ln-footer__col-heading">HELP</h3>
        {%- if help_menu != blank -%}
          <ul class="ln-footer__links" role="list">
            {%- for link in help_menu.links -%}
              {%- unless link.title contains 'Track' -%}
                <li><a class="ln-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <ul class="ln-footer__links" role="list">
            <li><a class="ln-footer__link" href="/policies/shipping-policy">Shipping &amp; Delivery</a></li>
            <li><a class="ln-footer__link" href="/policies/refund-policy">Returns &amp; Exchanges</a></li>
            <li><a class="ln-footer__link" href="/pages/warranty">Warranty</a></li>
            <li><a class="ln-footer__link" href="/pages/faq">FAQ</a></li>
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Col 4 — LUMENOOK {%- endcomment -%}
      <div class="ln-footer__col">
        <h3 class="ln-footer__col-heading">LUMENOOK</h3>
        {%- if brand_menu != blank -%}
          <ul class="ln-footer__links" role="list">
            {%- for link in brand_menu.links -%}
              {%- unless link.title contains 'Track' -%}
                <li><a class="ln-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <ul class="ln-footer__links" role="list">
            <li><a class="ln-footer__link" href="/pages/about">About</a></li>
            <li><a class="ln-footer__link" href="/blogs/journal">Journal</a></li>
            <li><a class="ln-footer__link" href="/pages/care-guide">Care Guide</a></li>
            <li><a class="ln-footer__link" href="/policies/privacy-policy">Privacy Policy</a></li>
          </ul>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- comment -%} ── Bottom bar ── {%- endcomment -%}
  <div class="ln-footer__bottom">
    <div class="ln-footer__inner ln-footer__bottom-inner">
      <p class="ln-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Prices include VAT.
      </p>
      <div class="ln-footer__policies">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a class="ln-footer__policy-link" href="{{ policy.url }}">{{ policy.title }}</a>
          {%- endif -%}
        {%- endfor -%}
        {%- if shop.policies == blank or shop.policies.size == 0 -%}
          <a class="ln-footer__policy-link" href="/policies">Terms &amp; Policies</a>
        {%- endif -%}
      </div>
    </div>
  </div>

</footer>

{% stylesheet %}
  /* ── Footer base ── */
  .ln-footer {
    background-color: var(--ln-night, #1C1917);
    color: var(--ln-ivory-on-dark, #EFE6DA);
    font-family: var(--font-body--family);
  }

  .ln-footer__inner {
    max-width: var(--page-width, 1320px);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 60px);
  }

  /* ── Newsletter bar ── */
  .ln-footer__newsletter {
    padding-block: clamp(48px, 6vw, 72px);
  }

  .ln-footer__newsletter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 32px;
  }

  @media screen and (max-width: 749px) {
    .ln-footer__newsletter-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .ln-footer__nl-heading {
    font-family: var(--font-heading--family);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 400;
    color: var(--ln-ivory-on-dark, #EFE6DA);
    margin: 0 0 8px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .ln-footer__nl-sub {
    font-size: 13px;
    color: #A89C91;
    margin: 0;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  .ln-footer__nl-form {
    width: 100%;
  }

  .ln-footer__nl-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
  }

  .ln-footer__nl-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #A89C91;
    font-family: var(--font-body--family);
    font-size: clamp(15px, 1.8vw, 20px);
    padding: 0;
    caret-color: var(--ln-brass, #B08D57);
  }

  .ln-footer__nl-input::placeholder {
    color: #A89C91;
  }

  .ln-footer__nl-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ln-ivory-on-dark, #EFE6DA);
    padding: 0;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .ln-footer__nl-btn:hover {
    color: var(--ln-brass, #B08D57);
  }

  .ln-footer__nl-line {
    height: 1px;
    background-color: #A89C91;
    width: 100%;
  }

  /* ── Divider between newsletter and body ── */
  .ln-footer__divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    max-width: 100%;
  }

  /* ── Main body ── */
  .ln-footer__body {
    padding-block: clamp(48px, 6vw, 72px);
  }

  .ln-footer__cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  @media screen and (max-width: 989px) {
    .ln-footer__cols {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }
    .ln-footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 479px) {
    .ln-footer__cols {
      grid-template-columns: 1fr;
    }
    .ln-footer__col--brand {
      grid-column: auto;
    }
  }

  /* ── Brand column ── */
  .ln-footer__logo-link {
    display: inline-block;
    text-decoration: none;
    color: var(--ln-ivory-on-dark, #EFE6DA);
    margin-bottom: 16px;
  }

  .ln-footer__tagline {
    font-size: 13px;
    color: #A89C91;
    line-height: 1.6;
    margin: 0 0 14px;
    max-width: 300px;
  }

  .ln-footer__email {
    display: inline-block;
    font-size: 13px;
    color: var(--ln-brass, #B08D57);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.3s ease;
  }

  .ln-footer__email:hover {
    color: var(--ln-ivory-on-dark, #EFE6DA);
  }

  /* ── Menu columns ── */
  .ln-footer__col-heading {
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ln-ivory-on-dark, #EFE6DA);
    margin: 0 0 20px;
  }

  .ln-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ln-footer__link {
    font-size: 14px;
    color: var(--ln-brass, #B08D57);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.3s ease;
    letter-spacing: 0.01em;
  }

  .ln-footer__link:hover {
    color: var(--ln-ivory-on-dark, #EFE6DA);
  }

  /* ── Bottom bar ── */
  .ln-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 20px;
  }

  .ln-footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  @media screen and (max-width: 479px) {
    .ln-footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  .ln-footer__copyright {
    font-size: 11px;
    color: #A89C91;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .ln-footer__policies {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ln-footer__policy-link {
    font-size: 11px;
    color: #A89C91;
    text-decoration: none;
    transition: color 0.3s ease;
    letter-spacing: 0.01em;
  }

  .ln-footer__policy-link:hover {
    color: var(--ln-ivory-on-dark, #EFE6DA);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lumenook Footer",
  "settings": [],
  "presets": [
    {
      "name": "Lumenook Footer"
    }
  ]
}
{% endschema %}
