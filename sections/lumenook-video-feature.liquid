{% comment %}
  Video feature (owner request): sits right below "In detail" (the image row). A vertical,
  framed phone-format video sits on one side and all the text on the other, so the section stays balanced. Only appears on
  products that have a video set in their "Feature video" metafield (lumenook.feature_video) —
  renders nothing otherwise, so most product pages are unaffected.
{% endcomment %}
{%- liquid
  assign video = product.metafields.lumenook.feature_video.value
-%}
{%- if video != blank -%}
  <section class="ln-video-feature ln-section{% if section.settings.media_position == 'right' %} ln-video-feature--media-right{% endif %}" aria-labelledby="LnVideoFeature-{{ section.id }}">
    <div class="ln-container ln-video-feature__layout">
      <div class="ln-video-feature__media">
        <div class="ln-video-feature__frame">
          <div class="ln-video-feature__screen">
            {%- render 'video',
              video: video,
              video_autoplay: true,
              video_loop: true,
              disable_controls: true,
              video_class: 'ln-video-feature__video'
            -%}
          </div>
        </div>
      </div>

      <div class="ln-video-feature__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="ln-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="ln-video-feature__heading" id="LnVideoFeature-{{ section.id }}">{{ section.settings.heading | default: product.title }}</h2>
        <ul class="ln-video-feature__points" role="list">
          {%- for i in (1..6) -%}
            {%- assign title_key = 'title_' | append: i -%}
            {%- assign text_key = 'text_' | append: i -%}
            {%- assign point_title = section.settings[title_key] -%}
            {%- assign point_text = section.settings[text_key] -%}
            {%- if point_title != blank -%}
              <li class="ln-video-feature__point">
                <span class="ln-video-feature__title">{{ point_title }}</span>
                {%- if point_text != blank -%}<span class="ln-video-feature__text">{{ point_text }}</span>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lumenook video feature",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows only on products with a video set in their \"Feature video\" metafield (Product → Metafields → Feature video)."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Video position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See it in action" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the product name." , "default": "Made to be seen" },
    { "type": "header", "content": "Points" },
    { "type": "text", "id": "title_1", "label": "Point 1 title", "default": "Real scale" },
    { "type": "text", "id": "text_1", "label": "Point 1 text", "default": "Filmed in a real room, so you can judge the size." },
    { "type": "text", "id": "title_2", "label": "Point 2 title", "default": "True colour" },
    { "type": "text", "id": "text_2", "label": "Point 2 text", "default": "See the finish and the glow as it really looks." },
    { "type": "text", "id": "title_3", "label": "Point 3 title", "default": "Shown in use" },
    { "type": "text", "id": "text_3", "label": "Point 3 text", "default": "Filmed the way you would show it to a friend." },
    { "type": "text", "id": "title_4", "label": "Point 4 title", "default": "Easy to place" },
    { "type": "text", "id": "text_4", "label": "Point 4 text", "default": "Sits comfortably on a bedside, desk or shelf." },
    { "type": "text", "id": "title_5", "label": "Point 5 title", "default": "What you see arrives" },
    { "type": "text", "id": "text_5", "label": "Point 5 text", "default": "The piece in the video is the piece at your door." },
    { "type": "text", "id": "title_6", "label": "Point 6 title", "default": "Delivered with care" },
    { "type": "text", "id": "text_6", "label": "Point 6 text", "default": "Packed carefully and sent across the UAE." }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [{ "name": "Lumenook video feature" }]
}
{% endschema %}
